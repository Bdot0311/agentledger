# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: claude-opus-5-5 for facts/policy, claude-haiku-5-5 for regulatory/PII)
JUDGE_MODEL=
JUDGE_MODEL_FAST=
RESEND_API_KEY=
# Fallback from-address if the workspace has none configured
RESEND_FROM=AgentLedger <ledger@yourdomain.com>
# Google OAuth client (Web application) with redirect URI {APP_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Seed script: the email you will log in with to see the demo workspace
SEED_EMAIL=demo@example.com
